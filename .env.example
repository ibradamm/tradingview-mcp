# Copy to .env and fill in. NEVER commit .env.

# Shared secret required on /mcp. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 24 characters. The server refuses to start without it unless ALLOW_UNAUTHENTICATED=true.
MCP_AUTH_TOKEN=
# Alternative to MCP_AUTH_TOKEN: comma-separated SHA-256 hex digests of accepted tokens
# (the server then never stores the plain token). python -c "import hashlib;print(hashlib.sha256(b'TOKEN').hexdigest())"
MCP_AUTH_TOKEN_SHA256=

# Local development only: allow running without a token.
ALLOW_UNAUTHENTICATED=false

# Requests per minute per client IP on /mcp (0 disables).
RATE_LIMIT_PER_MINUTE=120

# Market data provider: "yahoo" (default, real data) or "synthetic" (offline, deterministic).
MARKET_DATA_PROVIDER=yahoo

# SQLAlchemy URL. SQLite by default; PostgreSQL example:
#   postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/trading_mcp.db

# Directory where trained ML models are saved.
MODEL_DIR=./data/models

# Persist fetched bars to the database (also used as fallback when the provider fails).
PERSIST_BARS=true

# Cache time-to-live for historical data, in seconds (0 disables the cache).
CACHE_TTL_SECONDS=300

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=https://claude.ai,https://claude.com

# Comma-separated list of accepted Host headers (DNS-rebinding protection).
# Empty = protection disabled (acceptable because /mcp requires the token).
ALLOWED_HOSTS=

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
